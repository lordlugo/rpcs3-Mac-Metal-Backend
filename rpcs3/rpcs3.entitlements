<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PPU/SPU LLVM and ASMJIT recompilers generate code at runtime (MAP_JIT) -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Some JIT paths map writable+executable memory without MAP_JIT -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Bundled third-party dylibs (Qt, LLVM, SDL, ...) are not signed by the same team -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- PlayStation Eye emulation -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Chat/SingStar microphone emulation -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
